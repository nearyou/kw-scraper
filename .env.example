# ============================================================
# KW Scraper - example configuration
# Copy to `.env` and adjust values. NEVER commit the real `.env`.
# ============================================================

# --- Database (PostgreSQL) ---
# Used by Flask app, parsers and scrapers.
DATABASE_URL=postgresql+psycopg2://ekwscraper_admin:CHANGE_ME@localhost:5432/kwscraper
# Password referenced by docker-compose.yml via ${DB_PASSWORD}
DB_PASSWORD=CHANGE_ME

# --- Flask ---
APP_SECRET=CHANGE_ME_TO_A_RANDOM_STRING
FLASK_APP=www.main

# --- Structured logging ---
# Each line is JSON. Per-process files rotate at 10 MB and retain five backups.
SERVICE_NAME=kw-scraper
# Detailed INFO events stay in the rotating file; only errors reach the terminal.
LOG_LEVEL=INFO
CONSOLE_LOG_LEVEL=ERROR
LOG_FILE=logs/kw-scraper.log

# Health is unhealthy above this rolling failure ratio or scrape age.
HEALTH_MAX_ERROR_RATE=0.25
HEALTH_ERROR_WINDOW_SECONDS=3600
HEALTH_MAX_SCRAPE_AGE_SECONDS=86400

# --- Celery / broker ---
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_CONCURRENCY=4
CELERY_POOL=prefork
CELERY_LOG_LEVEL=ERROR
# Optional: CELERY_PREFETCH_MULTIPLIER
# Container startup retries storage and queue before launching the service.
DEPENDENCY_MAX_ATTEMPTS=30
DEPENDENCY_RETRY_MAX_DELAY=10

# --- Scraping concurrency ---
DOWNLOAD_WORKERS=6
PARSING_WORKERS=3
IN_FLIGHT_LIMIT=16
# Optional: IDLE_DOWNLOAD_WORKERS

# --- Idle scraping ---
IDLE_SCRAPE_ENABLED=true
IDLE_EMPTY_STREAK_LIMIT=40000
# Seconds between maintenance-mode health checks
MAINTENANCE_CHECK_INTERVAL=21600

# --- Rate limiting / anti-detection delays (seconds) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MIN=0.3
RATE_LIMIT_MAX=0.8
BOOK_DELAY_MIN=0.5
BOOK_DELAY_MAX=1.5
SECTION_DELAY_MIN=0.2
SECTION_DELAY_MAX=0.5
SEARCH_DELAY_MIN=0.1
SEARCH_DELAY_MAX=0.3

# --- External call resilience ---
# Calls retry with base, 2x base, 4x base... up to the configured maximum.
EXTERNAL_RETRY_ATTEMPTS=3
CB_BASE=1
CB_MAX=30
# Open the government-site circuit after this many consecutive failures.
CB_THRESHOLD=5
# Seconds before one worker is allowed to probe the site again.
CB_RESET_SECONDS=60

# --- Session and timeout controls ---
SESSION_MAX_REQUESTS=20
SESSION_MAX_AGE_SECONDS=900
ELEMENT_TIMEOUT=10
PAGE_LOAD_TIMEOUT=45
SCRIPT_TIMEOUT=20
RESULT_TIMEOUT=15
SCRAPE_TIMEOUT=180
# Commit only contiguous successful progress at this interval.
PROGRESS_CHECKPOINT_INTERVAL=5

# --- Dev / testing ---
# Set to any of 1/true/yes/y to scrape WITHOUT proxies (development only).
TEST_MODE=false

# --- Monitoring (optional) ---
# SENTRY_DSN=https://...@ingest.sentry.io/...

# --- Proxy management ---
# Proxies are stored in the database (managed through the web UI).
# These optional values securely pre-seed one authenticated proxy at startup.
# Keep the real password only in `.env`; never commit it.
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_SCHEME=http
# Set true when this environment proxy should replace old database proxies.
PROXY_REPLACE_EXISTING=false
